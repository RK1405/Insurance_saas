# --- Required in production ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/healthstack
# Managed Postgres (RDS / Cloud SQL / Azure) usually needs TLS:
DATABASE_SSL=true
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Optional ---
PORT=8080
SESSION_HOURS=12
# Load the demo organisation and users on first start (turn off for real customers)
SEED_DEMO=false
# Set to false to stop self sign-up; admins then invite users from Settings → Team
ALLOW_REGISTRATION=true
# Only for running NODE_ENV=production over plain http (e.g. docker compose on a laptop)
COOKIE_INSECURE=false
